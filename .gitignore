# The repository is public: never commit addresses of private machines, user paths, keys or
# screenshots of real files.

# Build output and the release workflow's dist/
/target/
/dist/

# Release artefacts and the self-updater's leftovers next to a running EXE
*.exe
*.exe.old
*.update.exe
*.failed.exe
*.update-ok
*.update-skip
*.part
*.pdb

# Screenshots from --screenshot runs (only the README's icon is kept)
/shots/*
!/shots/ikona.png

# Local settings, secrets, logs
.env
.env.*
*.log
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Agents' local files
TASKS.md
.claude/settings.local.json
