<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Embedded by build.rs. No DPI, common-controls or theme entries: eframe sets DPI at run time and the look must not change. -->
<!-- No heapType SegmentHeap: 1-2 MB less private memory of about 112 MB, thumbnail CPU not better (10.2-10.7 s against 9.2-10.1 s, two runs each). -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 share this id -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- takes effect only where LongPathsEnabled is set (Windows 10 1607+), and only for plain Win32 file calls, not shell operations -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
